    "test:blocs:annulation:jdd:mp4": "npm run test:blocs:annulation:jdd:record && bash int2-ihm-scripts/int2-ihm-transcode-evidence-mp4.sh test-results int2-ihm-recordings/blocs-annulation-jdd",
