{
  "name": "orion-test-auto",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "int2-ihm-tests"
  },
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "hooks:int2:start": "node int2-ihm-scripts/int2-ihm-business-hooks-server.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:int2:record": "playwright test int2-ihm-tests/int2-collaborateur-e2e.spec.ts --config=playwright.int2.record.config.ts",
    "test:int2:mp4": "npm run test:int2:record && bash int2-ihm-scripts/int2-ihm-transcode-evidence-mp4.sh int2-ihm-test-results int2-ihm-recordings/int2",
    "test:exhaustive:record": "playwright test --config=playwright.exhaustive.record.config.ts",
    "test:exhaustive:mp4": "rm -rf int2-ihm-test-results/exhaustive int2-ihm-recordings/exhaustive && mkdir -p int2-ihm-recordings/exhaustive && npm run test:exhaustive:record && bash int2-ihm-scripts/int2-ihm-transcode-evidence-mp4.sh int2-ihm-test-results/exhaustive int2-ihm-recordings/exhaustive",
    "test:chains:record": "playwright test --config=playwright.chains.record.config.ts",
    "test:chains:mp4": "rm -rf int2-ihm-test-results/chains && npm run test:chains:record && bash int2-ihm-scripts/int2-ihm-transcode-evidence-mp4.sh int2-ihm-test-results/chains int2-ihm-recordings/chains",
    "test:all:working+chains:mp4": "npm run test:chains:mp4 && npm run test:working:mp4",
    "test:full:exhaustive": "bash int2-ihm-scripts/int2-ihm-run-regression-exhaustive.sh",
