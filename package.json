    "report:int2:super": "node int2-ihm-scripts/int2-ihm-report-super.js",
    "report:int2:functional:strict10": "INT2_MATRIX_MIN_MANIFESTS=10 node int2-ihm-scripts/int2-ihm-report-functional-matrix.js",
    "report:int2:functional:strict12": "INT2_MATRIX_MIN_MANIFESTS=12 node int2-ihm-scripts/int2-ihm-report-functional-matrix.js",
    "report:pptx:exhaustive": "node int2-ihm-scripts/int2-ihm-report-exhaustive-pptx.js",
