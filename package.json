    "orion:dashboard:serve": "node int2-ihm-scripts/orion-dashboard.js && cd mon-espace/recette-sprints-11-12-13/livrables-opencode && echo 'Dashboard: http://127.0.0.1:8099/orion-dashboard.html?live' && python3 -m http.server 8099 --bind 127.0.0.1",
    "orion:pipeline:prepare": "node int2-ihm-scripts/orion-local-pipeline.js",
    "orion:pipeline:run": "node int2-ihm-scripts/orion-local-pipeline.js --run",
    "orion:pipeline:run:headed": "ORION_PLAYWRIGHT_CONFIG=playwright.orion.headed.config.ts ORION_RESULT_DIR=int2-ihm-test-results/orion-pipeline-headed node int2-ihm-scripts/orion-local-pipeline.js --run",
    "test:orion:pipeline": "playwright test --config=playwright.orion.pipeline.config.ts",
    "test:orion:headed": "playwright test --config=playwright.orion.headed.config.ts",
