    "agent:int2:creation:semantics": "node int2-ihm-scripts/int2-ihm-agent-form-semantics.js",
    "agent:int2:workflow": "node int2-ihm-scripts/int2-ihm-agent-workflow-orchestrator.js",
    "agent:int2:workflow:preprod": "INT2_JDD_GATE_CMD=\"npm run agent:int2:jdd:gate:preprod\" INT2_REPORT_CMD=\"npm run report:int2:functional:strict10\" node int2-ihm-scripts/int2-ihm-agent-workflow-orchestrator.js",
    "agent:int2:workflow:prod": "INT2_E2E_FULL_CHAIN=true INT2_STRICT_E2E=true INT2_ALLOW_CREATE_SUBMIT=true INT2_REQUIRE_PERSISTED_CREATE=true INT2_JDD_GATE_CMD=\"npm run agent:int2:jdd:gate:prod\" INT2_REPORT_CMD=\"npm run report:int2:functional:strict12\" node int2-ihm-scripts/int2-ihm-agent-workflow-orchestrator.js",
