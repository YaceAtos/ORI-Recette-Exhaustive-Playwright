  "agent:int2:discover": "node int2-ihm-scripts/int2-ihm-agent-discovery.js",
    "agent:int2:discover:deep": "INT2_DISCOVERY_MAX_PAGES=220 INT2_DEEP_MAX_INTERACTIONS=20 node int2-ihm-scripts/int2-ihm-agent-discovery-deep.js",
    "agent:int2:extract:multi-agent": "node int2-ihm-scripts/int2-ihm-agent-page-extractors-orchestrator.js",
    "agent:int2:synthesize": "node int2-ihm-scripts/int2-ihm-agent-scenarios-synthesizer.js",
    "agent:int2:jdd:gate": "node int2-ihm-scripts/int2-ihm-agent-jdd-gate.js",
    "agent:int2:jdd:gate:preprod": "INT2_JDD_MIN_SEARCH_TERMS=36 INT2_JDD_MIN_PROFILED_URLS=12 INT2_JDD_MIN_DISCOVERED_PAGES=17 INT2_MATRIX_MIN_MANIFESTS=10 node int2-ihm-scripts/int2-ihm-agent-jdd-gate.js",
    "agent:int2:jdd:gate:prod": "INT2_JDD_MIN_SEARCH_TERMS=36 INT2_JDD_MIN_PROFILED_URLS=12 INT2_JDD_MIN_DISCOVERED_PAGES=17 INT2_MATRIX_MIN_MANIFESTS=12 node int2-ihm-scripts/int2-ihm-agent-jdd-gate.js",
