# Hook endpoint consumed by Playwright tests via Int2BusinessHarness
ORION_HOOK_EXEC_URL=http://127.0.0.1:8787/exec
# Optional inbound auth shared between tests and local hook server
# ORION_HOOK_API_KEY=change-me

# Local hook server bind
ORION_HOOK_HOST=127.0.0.1
ORION_HOOK_PORT=8787

# Optional auth from local hook server to upstream executors
# ORION_UPSTREAM_API_KEY=change-me
# Optional mode: auto (default) sends both Authorization: Bearer + x-api-key
# ORION_UPSTREAM_API_KEY_MODE=auto
# Optional upstream API key header controls:
# ORION_UPSTREAM_API_KEY_HEADER=Authorization
# ORION_UPSTREAM_API_KEY_PREFIX=Bearer

# Preferred mode: one real INT2 endpoint that routes by { chain, action, payload }
# ORION_UPSTREAM_EXEC_URL=https://your-int2-orchestrator/exec

# Advanced mode: per-action overrides (only needed if actions go to different services)
ORION_UPSTREAM_SEED_URL=
ORION_UPSTREAM_CLEANUP_URL=
ORION_UPSTREAM_CREATE_SERIES_URL=
ORION_UPSTREAM_TRIGGER_RRULE_URL=
ORION_UPSTREAM_READ_INTERVENTIONS_URL=
ORION_UPSTREAM_UPDATE_INTERVENTION_URL=
ORION_UPSTREAM_CANCEL_INTERVENTION_URL=
ORION_UPSTREAM_VERIFY_KAFKA_URL=
ORION_UPSTREAM_VERIFY_SIRENE_URL=
ORION_UPSTREAM_VERIFY_INS_LIFECYCLE_URL=
ORION_UPSTREAM_VERIFY_DMP_URL=
